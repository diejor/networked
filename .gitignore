# Godot 4+ specific ignores
.godot/
/android/
# gdUnit report output. The glob is deliberate: a scoped run is pinned with
# `-rd res://reports_<name>` and every new suffix someone invents is generated
# output too, so ignoring the known names alone always falls behind the tools.
/reports*
*.tmp

# Export outputs (CI stages the examples site here; see pages-examples.yml)
/build/

# Native build artifacts are generated locally and are not committed.
/addons/networked/bin/

# SCons object cache for the native build.
/.scons_cache/

# Staged cells, packaged addons and release manifests, produced by ci/build.py
# and ci/package.py. Everything here is rebuildable from a source revision.
/dist/

# Engines ci/engine.py installs from the catalog.
/.engines/

# Pinned lint and rehearsal binaries ci/bootstrap.py installs.
/ci/.tools/

addons/gdUnit4/GdUnitRunner.cfg

tmp
tmp_saves
tmp_save
saves
/save/

# Ignore temporary files starting with a tilde (like your ~libwebrtc...dll)
~*

# Optional: Ignore backup/temp files ending with a tilde (common in many editors)
*~
# Docs build outputs
docs/_build/
docs/api/
docs/api_filtered/
docs/api_probe/
# Staging dirs for `make api`. It renames them into place on success, so they
# only survive a run that stopped early, which is any run while the class
# reference still reports errors.
docs/api_new/
docs/api_filtered_new/
docs/classes_new/
docs/sphinx_warnings.txt

# docs/tools/make_rst.py is generated by build_make_rst.py from vendor +
# patches/. We keep it tracked (like a lockfile) so contributors can read it
# without running the build; CI verifies via `build_make_rst.py --check`.
# To regenerate after editing a patch:  python tools/build_make_rst.py

node_modules/
.wrangler/
# CocoIndex Code (ccc)
/.cocoindex_code/
__pycache__/
