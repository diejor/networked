#!/bin/sh
# Formats the GDScript the style gate covers, holding out the files the
# formatter corrupts.
#
# gdscript-formatter 0.20.1 treats a `#region` marker written at column zero
# inside an indented `class` body as the end of that body, and re-indents
# everything after it to file scope. In prediction_core.gd that lifts
# `_PredictionEngine`'s static kernels out of their own class. The output is
# still valid GDScript, so neither `--check-only` nor the formatter's `--safe`
# mode notices, and the damage only appears at runtime as "Nonexistent
# function" cascades against a class that no longer has those methods.
#
# Indenting the markers is not the answer either. The kernel purity law in
# tests/unit/sim/test_predict_kernel_purity.gd locates the fence with
# `line.begins_with("#region Kernels")`, so column zero is part of how that
# rule is enforced. Until the formatter stops rewriting the nesting, these two
# files stay out of its reach.
#
# Usage:
#     scripts/gdformat              format in place
#     scripts/gdformat --check      check only, the CI gate

set -eu

HELD_OUT="
addons/networked/context/session/netw_entity.gd
addons/networked/replication/prediction_core.gd
"

files=$(find addons/networked tests -name '*.gd' | sort)
for held in $HELD_OUT; do
    files=$(printf '%s\n' "$files" | grep -v -x "$held")
done

# shellcheck disable=SC2086
printf '%s\n' "$files" | xargs gdscript-formatter "$@"
