#!/usr/bin/env python

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

from SCons.Script import ARGUMENTS, BoolVariable, Default, Dir
from SCons.Script import Environment, Exit, Help, SConscript, Variables

import sources

ROOT = Path(Dir("#").abspath)
DEPS_FILE = ROOT / "deps.env"
SUBSYSTEMS_FILE = ROOT / "include" / "netw" / "subsystems.hpp"

LEAF_ZONE_SUBSYSTEMS = ("WIRE", "INTERPOLATION")


def leaf_masked_subsystems():
    """The NETW_SUBSYSTEMS value with every LEAF_ZONE_SUBSYSTEMS bit cleared."""
    text = SUBSYSTEMS_FILE.read_text(encoding="utf-8")
    indices = dict(
        (name, int(index))
        for name, index in re.findall(
            r'X\((\w+),\s*"[^"]*",\s*(\d+)\)',
            text,
        )
    )
    missing = [n for n in LEAF_ZONE_SUBSYSTEMS if n not in indices]
    if missing:
        Exit("networked: subsystems.hpp has no bit for {}".format(", ".join(missing)))
    mask = 0xFFFFFFFF
    for name in LEAF_ZONE_SUBSYSTEMS:
        mask &= ~(1 << indices[name])
    return "{:#010x}U".format(mask)


def read_pins():
    pins = {}
    for raw_line in DEPS_FILE.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        key, value = line.split("=", 1)
        pins[key] = value
    return pins


def checkout_dependency(name, url, destination, ref):
    git_dir = destination / ".git"
    if not git_dir.exists():
        print("Fetching {} at {}...".format(name, ref))
        destination.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "init", str(destination)], check=True)
        subprocess.run(
            ["git", "-C", str(destination), "remote", "add", "origin", url],
            check=True,
        )
        subprocess.run(
            [
                "git",
                "-C",
                str(destination),
                "fetch",
                "--depth",
                "1",
                "origin",
                ref,
            ],
            check=True,
        )
        subprocess.run(
            [
                "git",
                "-C",
                str(destination),
                "checkout",
                "--detach",
                "FETCH_HEAD",
            ],
            check=True,
        )
    head = subprocess.run(
        ["git", "-C", str(destination), "rev-parse", "HEAD"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if len(ref) == 40 and all(ch in "0123456789abcdef" for ch in ref):
        expected = ref
    else:
        remote = subprocess.run(
            [
                "git",
                "-C",
                str(destination),
                "ls-remote",
                "origin",
                "refs/tags/{}".format(ref),
            ],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
        expected = remote.split()[0]
    if head != expected:
        print(
            "{} is at {}, but deps.env pins {}. Remove it and rebuild.".format(
                name,
                head,
                expected,
            )
        )
        Exit(1)


pins = read_pins()
godot_cpp = ROOT / "thirdparty" / "godot-cpp"
tracy = ROOT / "thirdparty" / "tracy"
checkout_dependency(
    "godot-cpp",
    "https://github.com/godotengine/godot-cpp.git",
    godot_cpp,
    pins["GODOT_CPP_REF"],
)
checkout_dependency(
    "Tracy",
    "https://github.com/wolfpld/tracy.git",
    tracy,
    pins["TRACY_REF"],
)

target_name = ARGUMENTS.get("target", "template_debug")
requested_platform = ARGUMENTS.get("platform", "")
default_profiling = False
variables = Variables(["custom.py"], ARGUMENTS)
variables.AddVariables(
    BoolVariable(
        "netw_profiling",
        "Compile Tracy instrumentation",
        default_profiling,
    ),
    BoolVariable(
        "netw_zone_leaves",
        "Compile the per-call leaf zones a normal profiling build masks out",
        False,
    ),
    BoolVariable("netw_tests", "Compile the Tier 2a doctest runner", False),
    BoolVariable("use_ccache", "Use ccache if available", True),
    BoolVariable("use_mold", "Use mold linker if available", True),
)
local_env = Environment(tools=["default"], PLATFORM="", variables=variables)
netw_profiling = bool(local_env["netw_profiling"])
netw_zone_leaves = bool(local_env["netw_zone_leaves"])
netw_tests = bool(local_env["netw_tests"])
use_ccache = bool(local_env["use_ccache"])
use_mold = bool(local_env["use_mold"])
Help(variables.GenerateHelpText(local_env))

for option in variables.options:
    ARGUMENTS.pop(option.key, None)

if requested_platform == "linux" or (not requested_platform and sys.platform.startswith("linux")):
    ARGUMENTS.setdefault("use_static_cpp", "no")

ARGUMENTS.setdefault("api_version", pins["GODOT_CPP_API_VERSION"])
env = SConscript(str(godot_cpp / "SConstruct"))
env = env.Clone()
if use_ccache and shutil.which("ccache"):
    env["CC"] = "ccache " + str(env.get("CC", "gcc"))
    env["CXX"] = "ccache " + str(env.get("CXX", "g++"))
if use_mold and shutil.which("mold"):
    env.Append(LINKFLAGS=["-fuse-ld=mold"])
env.Append(CXXFLAGS=["-std=c++17"])
env.Append(CPPPATH=[str(ROOT), str(ROOT / "include")])
sources.hold_determinism_floor(
    env,
    lambda message: Exit("networked: " + message),
    ARGUMENTS,
)
env.Append(
    CPPDEFINES=sources.feature_defines(
        sources.GDEXTENSION,
        netw_profiling,
        netw_tests,
    ),
)
env["netw_tests"] = netw_tests

sources.write_hosted_manifest()

build_sources = sources.get_sources(
    env,
    env["target"] in ["editor", "template_debug"],
)

if env["target"] in ["editor", "template_debug"]:
    doc_xml = Glob("doc_classes/*.xml")
    if doc_xml:
        build_sources.append(
            env.GodotCPPDocData("gen/doc_data.gen.cpp", source=doc_xml),
        )
if netw_profiling:
    env.Append(CPPPATH=[str(tracy / "public")])
    env.Append(
        CPPDEFINES=[
            "TRACY_ENABLE",
            "TRACY_ON_DEMAND",
            "TRACY_ONLY_LOCALHOST",
            "TRACY_DELAYED_INIT",
            "TRACY_MANUAL_LIFETIME",
        ],
    )
    if not netw_zone_leaves:
        env.Append(
            CPPDEFINES=[("NETW_SUBSYSTEMS", leaf_masked_subsystems())],
        )
    tracy_env = env.Clone()
    build_sources.append(
        tracy_env.SharedObject(str(tracy / "public" / "TracyClient.cpp")),
    )

bin_dir = ROOT.parent / "addons" / "networked" / "bin"
if env["platform"] == "macos":
    library_path = (
        bin_dir
        / "libnetworked.{}.{}.framework".format(env["platform"], env["target"])
        / "libnetworked.{}.{}".format(env["platform"], env["target"])
    )
else:
    library_path = bin_dir / "libnetworked{}{}".format(
        env["suffix"],
        env["SHLIBSUFFIX"],
    )


def deploy_manifest(target, source, env):
    """Copy the manifest, turning reloading off for an instrumented build."""
    text = Path(str(source[0])).read_text(encoding="utf-8")
    if netw_profiling:
        text = text.replace("reloadable = true", "reloadable = false")
    Path(str(target[0])).write_text(text, encoding="utf-8")


library = env.SharedLibrary(str(library_path), source=build_sources)
manifest = env.Command(
    str(bin_dir / "networked.gdextension"),
    [str(ROOT / "networked.gdextension"), env.Value(netw_profiling)],
    deploy_manifest,
)
env.NoCache(library)
Default([library, manifest])
