<?xml version="1.0" encoding="UTF-8" ?>
<class name="NetwClockConfig" inherits="Resource" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		Configuration for the clock of [member Node.multiplayer].
	</brief_description>
	<description>
		Returned by [method Netw.configure_clock].
		[codeblock]
		func _init() -&gt; void:
		    Netw.configure_clock(self).ticks_per_second(60).display_offset_ticks(2)
		[/codeblock]
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="display_offset_ticks">
			<return type="NetwClockConfig" />
			<param index="0" name="display_offset" type="int" />
			<description>
				Sets [member display_offset] and returns this config.
			</description>
		</method>
		<method name="physics_interpolation">
			<return type="NetwClockConfig" />
			<param index="0" name="use_physics_interpolation" type="bool" />
			<description>
				Sets [member use_physics_interpolation] and returns this config.
			</description>
		</method>
		<method name="sync">
			<return type="NetwClockConfig" />
			<param index="0" name="sync_mode" type="int" enum="NetwMultiplayer.SyncMode" />
			<description>
				Sets [member sync_mode] and returns this config.
			</description>
		</method>
		<method name="ticks_per_second">
			<return type="NetwClockConfig" />
			<param index="0" name="tickrate" type="int" />
			<description>
				Sets [member tickrate] and returns this config.
			</description>
		</method>
	</methods>
	<members>
		<member name="display_offset" type="int" setter="set_display_offset" getter="get_display_offset" default="2">
			How many ticks in the past remote entities are shown. A small value helps hide lag.
		</member>
		<member name="enable_drift_logging" type="bool" setter="set_enable_drift_logging" getter="get_enable_drift_logging" default="false">
			Logs average clock drift over 60-second windows to the console.
		</member>
		<member name="jitter_multiplier" type="float" setter="set_jitter_multiplier" getter="get_jitter_multiplier" default="2.0">
			How much jitter adds to [member NetwClockHandle.recommended_display_offset].
		</member>
		<member name="jitter_stability_threshold" type="float" setter="set_jitter_stability_threshold" getter="get_jitter_stability_threshold" default="0.05">
			Seconds of jitter under which the connection counts as stable.
		</member>
		<member name="jitter_window" type="int" setter="set_jitter_window" getter="get_jitter_window" default="16">
			How many recent pings are averaged.
		</member>
		<member name="max_ticks_per_frame" type="int" setter="set_max_ticks_per_frame" getter="get_max_ticks_per_frame" default="8">
			The most ticks run in one physics frame.
		</member>
		<member name="panic_snap_threshold" type="int" setter="set_panic_snap_threshold" getter="get_panic_snap_threshold" default="20">
			Ticks of difference from the server past which the clock snaps, even with [constant NetwMultiplayer.SYNC_MODE_STRETCH].
		</member>
		<member name="ping_interval" type="float" setter="set_ping_interval" getter="get_ping_interval" default="0.1">
			Seconds between pings to the server.
		</member>
		<member name="stall_threshold" type="float" setter="set_stall_threshold" getter="get_stall_threshold" default="1.0">
			Seconds. A longer frame is treated as a hitch and skipped.
		</member>
		<member name="stretch_nudge_factor" type="float" setter="set_stretch_nudge_factor" getter="get_stretch_nudge_factor" default="0.05">
			The share of the difference [constant NetwMultiplayer.SYNC_MODE_STRETCH] corrects each frame.
		</member>
		<member name="sync_mode" type="int" setter="set_sync_mode" getter="get_sync_mode" enum="NetwMultiplayer.SyncMode" default="1">
			How the clock is corrected toward the server's.
		</member>
		<member name="tickrate" type="int" setter="set_tickrate" getter="get_tickrate" default="30">
			Ticks per second. Higher is more precise, and costs more bandwidth and CPU.
		</member>
		<member name="tickrate_mismatch_action" type="int" setter="set_tickrate_mismatch_action" getter="get_tickrate_mismatch_action" enum="NetwMultiplayer.MismatchAction" default="0">
			What happens when a peer has a different [member tickrate].
		</member>
		<member name="use_physics_interpolation" type="bool" setter="set_use_physics_interpolation" getter="get_use_physics_interpolation" default="true">
			Whether [member NetwClockHandle.tick_factor] follows [method Engine.get_physics_interpolation_fraction].
		</member>
	</members>
</class>
