<?xml version="1.0" encoding="UTF-8" ?>
<class name="NetwSchemaColumn" inherits="RefCounted" api_type="extension" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/godotengine/godot/master/doc/class.xsd">
	<brief_description>
		One column of a [NetwSchema].
	</brief_description>
	<description>
		Created by [method NetwSchema.column], not directly.
	</description>
	<tutorials>
	</tutorials>
	<members>
		<member name="key" type="StringName" setter="set_key" getter="get_key" default="&amp;&quot;&quot;">
			The column name, unique in its schema.
		</member>
		<member name="quantizer" type="NetwQuantize" setter="set_quantizer" getter="get_quantizer">
			How the value is compressed, or [code]null[/code] to send it as is.
		</member>
		<member name="stride" type="int" setter="set_stride" getter="get_stride" default="1">
			How many values each row holds.
		</member>
		<member name="type" type="int" setter="set_type" getter="get_type" enum="NetwMultiplayer.ColumnType" default="0">
			The type of the values.
		</member>
	</members>
</class>
