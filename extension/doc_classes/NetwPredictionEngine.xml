		<method name="canonicalize_input" qualifiers="const">
			<return type="Dictionary" />
			<param index="0" name="slot" type="int" />
			<param index="1" name="payload" type="Dictionary" />
			<description>
				[param payload] with every declared input value round-tripped through its own codec, so both peers feed the simulation the same values.
			</description>
		</method>
		<method name="canonicalize_state" qualifiers="const">
			<return type="Dictionary" />
			<param index="0" name="slot" type="int" />
			<param index="1" name="payload" type="Dictionary" />
			<description>
				[param payload] with every declared state value round-tripped through its own codec.
				A predicting peer and its authority never see the same float twice, one reads a live property and the other reads what survived the wire, so the round trip is what makes the two comparable exactly rather than approximately. A field with no quantizer round-trips through its raw wire form.
			</description>
		</method>
